<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="backend.mapper.UserMapper">

    <!-- メールアドレスからユーザー取得 -->
    <select id="findByEmail"
            parameterType="string"
            resultType="backend.entity.User">

        SELECT
        id,
        name,
        email,
        password,
        role,
        created_at AS createdAt,
        updated_at AS updatedAt
        FROM users
        WHERE email = #{email}

    </select>

    <!-- メールアドレス重複チェック -->
    <select id="countByEmail"
            parameterType="string"
            resultType="int">

        SELECT COUNT(*)
        FROM users
        WHERE email = #{email}

    </select>

    <!-- ユーザー登録 -->
    <insert id="insertUser"
            parameterType="backend.entity.User"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO users (
        name,
        email,
        password,
        role,
        created_at,
        updated_at
        )
        VALUES (
        #{name},
        #{email},
        #{password},
        #{role},
        NOW(),
        NOW()
        )

    </insert>

</mapper>