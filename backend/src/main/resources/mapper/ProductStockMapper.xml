<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="backend.mapper.ProductStockMapper">

    <!-- 商品在庫登録 -->
    <insert id="insert">

        INSERT INTO product_stocks
        (
        product_id,
        stock_quantity,
        version,
        created_at,
        updated_at
        )
        VALUES
        (
        #{productId},
        #{stockQuantity},
        0,
        NOW(),
        NOW()
        )

    </insert>

</mapper>