<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="backend.mapper.CategoryMapper">

    <!--
        カテゴリ一覧取得
    -->
    <select id="findAll" resultType="backend.entity.Category">
        SELECT
        id,
        name,
        created_at AS createdAt,
        updated_at AS updatedAt
        FROM categories
        ORDER BY id
    </select>

</mapper>