<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="backend.mapper.CartMapper">

    <!-- カート取得（ユーザーIDから）-->
    <select id="findByUserId"
            resultType="backend.entity.Cart">

        SELECT
        id,
        user_id,
        created_at,
        updated_at
        FROM carts
        WHERE user_id = #{userId}

    </select>

    <!-- カート新規作成 -->
    <insert id="insert"
            parameterType="backend.entity.Cart"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO carts
        (
        user_id,
        created_at,
        updated_at
        )
        VALUES
        (
        #{userId},
        NOW(),
        NOW()
        )

    </insert>

</mapper>